package assign07;
import assign06.List;
/**
 * @author Ava Murphy and Yujia Zhao
 * @Version 10/29/2026
 * Static method class that finds paths from a given set of data
 */
public class GraphUtility {
	/**
	 * Finds the shortest path between vertices, ignoring edge weights
	 * @param sources- list of starting point vertices 
	 * @param destinations- list of destination vertices
	 * @param srcData- starting point for search
	 * @param dstData- stopping point for search
	 * @return Linked List of vertices, in order representing a path
	 */
	public static <Type> List<Type> shortestPath(List<Type> sources, List<Type> destinations, Type srcData, Type dstData) {
		Graph<Type> newGraph = new Graph<>(sources, destinations);
		List<Type> path = newGraph.breadthFirstSearch(srcData, dstData);
		//Error handles for no start or end values, no path, or mismatch data
		if(!newGraph.graph.containsKey(srcData) || !newGraph.graph.containsKey(dstData) || destinations.size() != sources.size() || path.size() == 0)
			throw new IllegalArgumentException("Mismatch data, graphs must be the same length and contain target values");
		return newGraph.breadthFirstSearch(srcData, dstData);
	}
	/**
	 * Finds the shortest path between vertices using edge weights
	 * @param sources- list of starting point vertices 
	 * @param destinations- list of destination vertices
	 * @param srcData- starting point for search
	 * @param dstData- stopping point for search
	 * @param- Edge weights corresponding to each previous vertex. Should be one less than source list
	 * @return Linked List of vertices, in order representing a path
	 */
	public static <Type> List<Type> shortestWeightedPath(List<Type> sources, List<Type> destinations, List<Double> weights, Type srcData, Type dstData) {
		Graph<Type> newGraph = new Graph<>(sources, destinations);
		List<Type> path = newGraph.dijkstrasAlgorithm(srcData, dstData);
		//Error handles for no start or end values, no path, or mismatch data
		if(!newGraph.graph.containsKey(srcData) || !newGraph.graph.containsKey(dstData) || destinations.size() != sources.size() || path.size() == 0)
			throw new IllegalArgumentException("Mismatch data, graphs must be the same length and contain target values");
		return newGraph.dijkstrasAlgorithm(srcData, dstData);
	}
	/**
	 * Orders topologically, meaning the closer points to start value come first
	 * @param sources- list of starting point vertices 
	 * @param destinations- list of destination vertices
	 * @return Linked List of vertices, in topological order
	 */
	public static <Type> List<Type> sort(List<Type> sources, List<Type> destinations) {
		Graph<Type> graph = new Graph<>(sources, destinations);
		//if graph contains cycles, throw an exception
		return graph.topoSort();
	}
	
}
