package assign07;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/** A directed, weighted graph backed by adjacency lists. */
public class Graph<Type> {

    final Map<Type, Vertex<Type>> vertices;

    /** Creates an empty graph. */
    public Graph() {
        vertices = new LinkedHashMap<>();
    }

    /** Adds a directed edge, creating its endpoints if necessary. */
    public void addEdge(Type source, Type destination, double weight) {
        if (source == null || destination == null
                || !Double.isFinite(weight) || weight < 0) {
            throw new IllegalArgumentException(
                    "Invalid edge endpoint or weight");
        }

        Vertex<Type> from =
                vertices.computeIfAbsent(source, Vertex::new);

        Vertex<Type> to =
                vertices.computeIfAbsent(destination, Vertex::new);

        from.outgoing.add(new Edge<>(to, weight));
        to.indegree++;
    }

    /** Returns an unweighted shortest path from source to destination. */
    public List<Type> breadthFirstSearch(Type source, Type destination) {
        return BFS.search(this, source, destination);
    }

    /** Returns a minimum-weight path from source to destination. */
    public List<Type> dijkstrasAlgorithm(Type source, Type destination) {
        return Dijkstra.search(this, source, destination);
    }

    /** Returns a topological ordering, or throws if the graph has a cycle. */
    public List<Type> topoSort() {
        return TopologicalSort.sort(this);
    }
}

/** A graph vertex, with adjacency and algorithm state stored together. */
class Vertex<Type> {

    final Type data;
    final List<Edge<Type>> outgoing;

    double distance;
    Vertex<Type> previous;
    int indegree;

    /** Creates a vertex with an empty outgoing-edge list. */
    public Vertex(Type data) {
        this.data = data;
        this.outgoing = new ArrayList<>();
        this.distance = Double.POSITIVE_INFINITY;
        this.previous = null;
        this.indegree = 0;
    }
}

/** A directed edge with a destination vertex and a nonnegative weight. */
class Edge<Type> {

    final Vertex<Type> destination;
    final double weight;

    /** Creates an edge to destination with the supplied weight. */
    public Edge(Vertex<Type> destination, double weight) {
        this.destination = destination;
        this.weight = weight;
    }
}
